FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    SAMBA_DOMAIN=EXAMPLE \
    SAMBA_REALM=EXAMPLE.LOCAL \
    SAMBA_ADMIN_PASSWORD=ChangeMe123!

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    samba \
    samba-dsdb-modules \
    samba-vfs-modules \
    samba-ad-provision \
    acl \
    attr \
    iproute2 \
    krb5-kdc \
    krb5-admin-server \
    winbind \
    krb5-user \
    dnsutils \
    smbclient \
    netcat-openbsd \
    python3 \
    python3-venv \
    python3-pip && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/dc-entrypoint.sh /usr/local/bin/dc-entrypoint.sh
COPY scripts/seed-directory.sh /usr/local/bin/seed-directory.sh

RUN chmod +x /usr/local/bin/dc-entrypoint.sh /usr/local/bin/seed-directory.sh

VOLUME ["/var/lib/samba", "/etc/samba", "/var/cache/samba"]

EXPOSE 53 53/udp 88 88/udp 135 138/udp 139 389 389/udp 445 464 464/udp 3268 3269

ENTRYPOINT ["/usr/local/bin/dc-entrypoint.sh"]
